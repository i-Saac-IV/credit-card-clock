		(at 106.426 122.428 0)
		(effects
			(font
				(size 1.524 1.524)
				(thickness 0.254)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "103590bc-c11c-47d7-b9d2-d94d90abf1f9")
	)
	(text "Switch 1)\n	Enables the 1Hz clock from the\n	ocslator and frequency dividers.\n\nSwitch 2)\n	Connects the \"RTC\" battery to VCC.\n\nSwitch 3)\n	Enables LEDs.\n\nSwitch 4)\n	Enables the 1Hz LED."
		(exclude_from_sim no)
		(at 241.046 109.982 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left bottom)
		)
		(uuid "31008ad5-b125-4cc3-bf5b-3ccef1447d09")
	)
	(text "Basic Contorl"
		(exclude_from_sim no)
		(at 283.464 119.634 0)
		(effects
			(font
				(size 1.524 1.524)
				(thickness 0.3048)
				(bold yes)
			)
			(justify right bottom)
		)
		(uuid "56566c8b-301c-4468-b8dd-fc29347fcbb0")
	)
	(text "Ports & Power"
		(exclude_from_sim no)
		(at 283.718 73.914 0)
		(effects
			(font
				(size 1.524 1.524)
				(thickness 0.3048)
				(bold yes)
			)
			(justify right bottom)
		)
		(uuid "6c92674e-bdf9-4fc6-901f-b2fa0829a6c2")
	)
	(text "The current limiting resistor is chosen\nsuch that I_LED = 5mA.\n\nAssuming:\n	VCC 		= 3V\n	V_F_LED 	= 2V\n	I_LED 		= 5mA\n\nR = (VCC - V_F_LED) / I_LED\nR = 200"
		(exclude_from_sim no)
		(at 107.696 127 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left top)
		)
		(uuid "74f00a11-d9b5-40b6-bb00-315419c248bf")
	)
